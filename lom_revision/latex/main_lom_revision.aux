\citation{clauset2009power}
\citation{clauset2009power}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Cumulative unique users over time for three representative 28-day experiment windows from the REES46 dataset.\let \reserved@d =[\def \par }}{9}{figure.caption.19}\protected@file@percent }
\newmarginnote{note.8.2}{{9}{16513579sp}}
\newlabel{fig:rees46_cumulative}{{1}{9}{Cumulative unique users over time for three representative 28-day experiment windows from the REES46 dataset.\reviewtag {A1} The vertical dashed line marks the pilot boundary at $D_0 = 7$ days. All three curves exhibit sub-linear (concave) growth, consistent with the power-law arrival pattern that the stable-beta prior is designed to capture. The model must extrapolate the remaining 21~days from only the first 7~days of observations.\relax }{figure.caption.19}{}}
\newlabel{fig:rees46_cumulative@cref}{{[figure][1][]1}{[1][8][]9}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Log-log scatter of day index versus number of new users arriving on that day, for three experiment windows.\let \reserved@d =[\def \par }}{10}{figure.caption.20}\protected@file@percent }
\newmarginnote{note.9.2}{{10}{14285401sp}}
\newlabel{fig:rees46_powerlaw}{{2}{10}{Log-log scatter of day index versus number of new users arriving on that day, for three experiment windows.\reviewtag {A1} The approximately linear trend on the log-log scale provides direct evidence for the power-law decay of new user arrivals \citep {clauset2009power}. This pattern is the empirical basis for using stable-beta scaled process priors, which produce power-law predictive distributions by construction.\relax }{figure.caption.20}{}}
\newlabel{fig:rees46_powerlaw@cref}{{[figure][2][]2}{[1][9][]10}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Daily new user arrivals across the 28-day experiment window.\let \reserved@d =[\def \par }}{11}{figure.caption.21}\protected@file@percent }
\newmarginnote{note.10.2}{{11}{29217896sp}}
\newlabel{fig:rees46_daily_new}{{3}{11}{Daily new user arrivals across the 28-day experiment window.\reviewtag {A1} Day~1 sees $\sim $190K new users; by day~28 this has decayed to $\sim $60K. The non-stationary decay pattern explains why simple Poisson or binomial models (which assume constant arrival rates) are inadequate for this data.\relax }{figure.caption.21}{}}
\newlabel{fig:rees46_daily_new@cref}{{[figure][3][]3}{[1][10][]11}}
\citation{clauset2009power}
\citation{clauset2009power}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Daily total trigger volume (all event types) across the 28-day window.\let \reserved@d =[\def \par }}{12}{figure.caption.22}\protected@file@percent }
\newmarginnote{note.11.2}{{12}{30666423sp}}
\newlabel{fig:rees46_triggers}{{4}{12}{Daily total trigger volume (all event types) across the 28-day window.\reviewtag {A1} Unlike new user arrivals (which decay), total triggers remain relatively stable at 1.2--1.6M per day. The gap between total triggers and new users represents re-trigger activity from returning users --- the signal that the \nbmodel {} model uniquely captures, and that the \bemodel {} and \tgmodel {} models cannot represent.\relax }{figure.caption.22}{}}
\newlabel{fig:rees46_triggers@cref}{{[figure][4][]4}{[1][11][]12}}
\@writefile{toc}{\contentsline {paragraph}{Key statistics.}{12}{section*.23}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces REES46: per-user trigger count distribution on a log-log scale (15.6M users, 7\nobreakspace  {}months).\let \reserved@d =[\def \par }}{13}{figure.caption.24}\protected@file@percent }
\newmarginnote{note.12.2}{{13}{8225290sp}}
\newlabel{fig:rees46_triggers_per_user}{{5}{13}{REES46: per-user trigger count distribution on a log-log scale (15.6M users, 7~months).\reviewtag {A1} The linear trend on the log-log scale is direct evidence for a power-law distribution of user engagement \citep {clauset2009power}. 24\% of users have exactly 1~trigger; the median is 5; the maximum is 199K.\relax }{figure.caption.24}{}}
\newlabel{fig:rees46_triggers_per_user@cref}{{[figure][5][]5}{[1][12][]13}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces REES46: number of active days per user (15.6M users, 211-day span).\let \reserved@d =[\def \par }}{13}{figure.caption.25}\protected@file@percent }
\newmarginnote{note.13.2}{{13}{30564220sp}}
\newlabel{fig:rees46_days_active}{{6}{13}{REES46: number of active days per user (15.6M users, 211-day span).\reviewtag {A1} 49\% of users are active on exactly 1~day; 74\% on 3~days or fewer. This extreme sparsity is the empirical pattern that motivates the use of BNP priors with power-law tails.\relax }{figure.caption.25}{}}
\newlabel{fig:rees46_days_active@cref}{{[figure][6][]6}{[1][13][]13}}
